# ============================================================================
# NIGHTWORKS® · KUTAK KATIK — ENVIRONMENT CONFIGURATION
# Copy this file to `.env` and fill in your PostgreSQL connection string.
# You can also configure DATABASE_URL directly from the Admin Dashboard UI!
# ============================================================================

PORT=3000

# PostgreSQL Direct Connection String:
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kutakkatik
